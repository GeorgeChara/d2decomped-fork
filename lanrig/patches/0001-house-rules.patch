diff --git a/components/rules/house.hpp b/components/rules/house.hpp
new file mode 100644
index 00000000..aa5b5df3
--- /dev/null
+++ b/components/rules/house.hpp
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// House rules: a LAN host's switches for its game (d2d --rules <file>), not
+// game.exe's. One setting a line, # starts a comment:
+//   players 8        monsters as for 8 players (life, exp, drops), as /players 8
+//   exp 3            times the experience
+//   gold 3           times the gold dropped
+//   magic find 100   extra magic find for everyone, in %
+// The defaults change nothing.
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <format>
+#include <sstream>
+#include <string>
+
+namespace d2d::rules {
+
+struct House {
+    int players = 1;          // at least this many, as /players n (1..8)
+    int exp_pct = 100;
+    int gold_pct = 100;
+    int magic_find = 0;
+};
+
+inline House& house() {
+    static House rules;
+    return rules;
+}
+
+// Reads a rules file's text over `out` (unset keys keep their value); a
+// line it can't read is an error naming it, and `out` is left alone.
+inline bool read_house(const std::string& text, House& out, std::string& error) {
+    House rules = out;
+    std::istringstream lines(text);
+    std::string line;
+    for (int number = 1; std::getline(lines, line); ++number) {
+        line = line.substr(0, line.find('#'));
+        std::istringstream words(line);
+        std::string key, second;
+        double value = 0;
+        if (!(words >> key)) continue;
+        if (key == "magic" && words >> second && second == "find") key = "magic find";
+        if (!(words >> value) || value < 0) { error = std::format("line {}: {} wants a number", number, key); return false; }
+        if (key == "players") rules.players = std::clamp(int(value), 1, 8);
+        else if (key == "exp") rules.exp_pct = int(std::lround(value * 100));
+        else if (key == "gold") rules.gold_pct = int(std::lround(value * 100));
+        else if (key == "magic find") rules.magic_find = int(value);
+        else { error = std::format("line {}: don't know '{}' (players, exp, gold, magic find)", number, key); return false; }
+    }
+    out = rules;
+    return true;
+}
+
+inline std::string describe(const House& rules) {
+    return std::format("players {}, exp x{:g}, gold x{:g}, magic find +{}%", rules.players, rules.exp_pct / 100.0, rules.gold_pct / 100.0, rules.magic_find);
+}
+
+}  // namespace d2d::rules
