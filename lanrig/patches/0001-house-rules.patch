diff --git a/tests/test_house.cpp b/tests/test_house.cpp
new file mode 100644
index 00000000..2060c7e2
--- /dev/null
+++ b/tests/test_house.cpp
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// test-links: rules
+// House rules files (d2d --rules): the keys, comments, a bad line leaving
+// the rules alone, and a change over the rules already set (debug rules).
+#include <house.hpp>
+
+#include <cassert>
+#include <cstdio>
+#include <string>
+
+using namespace d2d::rules;
+
+int main() {
+    House rules;
+    std::string error;
+    assert(read_house("# Quick Start night\nplayers 8\nexp 3   # times\ngold 1.5\nmagic find 100\n", rules, error));
+    assert(rules.players == 8 && rules.exp_pct == 300 && rules.gold_pct == 150 && rules.magic_find == 100);
+    assert(describe(rules) == "players 8, exp x3, gold x1.5, magic find +100%");
+
+    assert(read_house("players 20", rules, error) && rules.players == 8);   // /players stops at 8
+    assert(read_house("exp 2", rules, error) && rules.exp_pct == 200 && rules.gold_pct == 150);   // the rest stay
+
+    const House before = rules;
+    assert(!read_house("exp 4\nspeed 2\n", rules, error));
+    assert(error.find("line 2") != std::string::npos && rules.exp_pct == before.exp_pct);
+    assert(!read_house("players lots", rules, error));
+
+    House none;
+    assert(read_house("", none, error) && none.players == 1 && none.exp_pct == 100);
+    std::puts("house: ok");
+}
